% Ejercicio 5: parentesco (hermano/a)
% hechos de ejemplo
progenitor(juan, maria).
progenitor(juan, pedro).
progenitor(ana, maria).
progenitor(ana, pedro).

hombre(pedro).
mujer(maria).

% regla para hermanos
es_hermano(X, Y) :-
    progenitor(P, X),
    progenitor(P, Y),
    X \= Y.

